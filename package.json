{
  "name": "entrega-facil",
  "version": "1.0.0",
  "description": "O Entrega Fácil é uma aplicação web responsiva para cadastro e acompanhamento básico de entregas. A aplicação permitirá cadastrar os dados do cliente, informações do produto, endereço de origem, endereço de destino, data prevista e status da entrega.",
  "scripts": {
    "sass:build": "sass --no-source-map assets/scss/main.scss:assets/css/main.css assets/scss/entregas.scss:assets/css/entregas.css assets/scss/cadastro.scss:assets/css/cadastro.css assets/scss/detalhes.scss:assets/css/detalhes.css",
    "sass:watch": "npm run sass:build -- --watch",
    "start": "node scripts/serve.cjs",
    "api": "json-server --watch db.json --host localhost --port 3000",
    "vendor:sync": "node scripts/sync-vendor.cjs",
    "images:build": "node scripts/build-images.cjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lucasbrugge/entrega-facil.git"
  },
  "keywords": [],
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/lucasbrugge/entrega-facil/issues"
  },
  "homepage": "https://github.com/lucasbrugge/entrega-facil#readme",
  "dependencies": {
    "bootstrap": "^5.3.8",
    "jquery": "4.0.0",
    "jquery-mask-plugin": "1.14.16"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "json-server": "0.17.4",
    "prettier": "3.9.10",
    "sass": "^1.105.2",
    "sharp": "0.35.5"
  },
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  }
}
