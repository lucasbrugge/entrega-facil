{
  "name": "entrega-facil",
  "version": "1.0.0",
  "description": "Casca responsiva do Entrega Fácil: três páginas HTML estáticas com Bootstrap e Sass para a 2ª entrega.",
  "scripts": {
    "sass:build": "sass --no-source-map assets/scss/main.scss:assets/css/main.css assets/scss/entregas.scss:app/entregas.css assets/scss/cadastro.scss:app/pages/cadastro/cadastro.css assets/scss/detalhes.scss:app/pages/detalhes/detalhes.css",
    "sass:watch": "npm run sass:build -- --watch",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lucasbrugge/entrega-facil.git"
  },
  "keywords": [],
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/lucasbrugge/entrega-facil/issues"
  },
  "homepage": "https://github.com/lucasbrugge/entrega-facil#readme",
  "dependencies": {
    "bootstrap": "^5.3.8"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "sass": "^1.105.2"
  },
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  }
}
