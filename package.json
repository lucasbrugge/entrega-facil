{
  "name": "entrega-facil",
  "version": "1.0.0",
  "description": "O Entrega Fácil é uma aplicação web responsiva para cadastro e acompanhamento básico de entregas. A aplicação permitirá cadastrar os dados do cliente, informações do produto, endereço de origem, endereço de destino, data prevista e status da entrega.",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "test": "node scripts/validate-sass.cjs",
    "sass:build": "sass --no-source-map assets/scss/main.scss assets/css/style.css",
    "sass:watch": "sass --no-source-map --watch assets/scss/main.scss:assets/css/style.css",
    "docs:sass": "node scripts/generate-sass-pdf.cjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lucasbrugge/entrega-facil.git"
  },
  "keywords": [],
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/lucasbrugge/entrega-facil/issues"
  },
  "homepage": "https://github.com/lucasbrugge/entrega-facil#readme",
  "dependencies": {
    "bootstrap": "^5.3.8",
    "jquery": "^4.0.0",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "gh-pages": "^6.3.0",
    "playwright": "^1.64.1",
    "sass": "^1.105.2"
  }
}
